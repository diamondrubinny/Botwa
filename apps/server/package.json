{
  "name": "@botwa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r src/migrations dist/migrations && mkdir -p dist/webchat && cp -r src/webchat/assets dist/webchat/assets && cp -r ../../wordpress-plugin/botwa-chat dist/webchat/wp-plugin",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "big-integer": "^1.6.52",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.6",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
