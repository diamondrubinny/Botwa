# Copy to .env and fill. NEVER commit .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://botwa:CHANGE_ME@db:5432/botwa
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Public origin of the admin panel (used for CSRF origin check)
APP_ORIGIN=https://botwa.example.com
# true behind HTTPS (always true in production)
COOKIE_SECURE=true
# Trust X-Forwarded-* from the reverse proxy
TRUST_PROXY=true
SESSION_TTL_HOURS=12
# Force MFA enrolment for admin/supervisor roles
REQUIRE_MFA_FOR_PRIVILEGED=true
# Delete messages older than N days (0 = keep forever). Set per your privacy policy.
MESSAGE_RETENTION_DAYS=365
