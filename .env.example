# Copy to .env and fill. NEVER commit .env.  (chmod 600 .env)

# --- Docker Compose deployment ---
DOMAIN=support.example.com                 # DNS A record must point to this server
DB_PASSWORD=CHANGE_ME_long_random          # openssl rand -base64 24 | tr -d '/+='

# --- Application ---
NODE_ENV=production
PORT=3000
# Generate: openssl rand -base64 32   (BACK THIS UP – without it stored sessions cannot be decrypted)
ENCRYPTION_KEY=
# Public origin of the admin panel (CSRF origin check). Must match what the browser shows.
APP_ORIGIN=https://support.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
REQUIRE_MFA_FOR_PRIVILEGED=true
# Delete messages older than N days (0 = keep forever). Set per your privacy policy.
MESSAGE_RETENTION_DAYS=365

# --- Telegram user-account login (optional). From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Attachments (images/PDF/Word/Excel/audio/video). OFF unless an antivirus daemon is configured.
# Docker: CLAMAV_HOST=clamav and start with `docker compose --profile media up -d`
CLAMAV_HOST=
CLAMAV_PORT=3310
MEDIA_MAX_MB=16                 # max 25 (clamd StreamMaxLength default); larger files cannot be scanned
MEDIA_MAX_TOTAL_GB=20           # stop accepting inbound files above this total stored size
MEDIA_MAX_FILES_PER_CONTACT_DAY=50
# MEDIA_ALLOW_UNSCANNED=false   # development ONLY: accept files without antivirus. Never in production.

# --- Encrypted database backups from the admin panel (needs pg_dump in the image; Dockerfile installs it)
BACKUP_KEEP=14
# Hour of day (0-23, server local time) for an automatic daily backup. Leave blank for manual only.
BACKUP_AUTO_HOUR=3

# --- Non-Docker only (compose overrides these) ---
# DATABASE_URL=postgres://botwa:PASSWORD@localhost:5432/botwa
# HOST=127.0.0.1
# MEDIA_DIR=./data/media
# BACKUP_DIR=./data/backups
# TRUST_PROXY=false
