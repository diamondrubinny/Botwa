# Copy to .env and fill. NEVER commit .env.  (chmod 600 .env)

# --- Docker Compose deployment ---
# DNS A record must point to this server
DOMAIN=support.example.com
# openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=CHANGE_ME_long_random

# Optional: publish Caddy only on this address (set automatically by the wizard if :80/:443 are partly in use)
# BIND_IP=

# --- Application ---
NODE_ENV=production
PORT=3000
# Generate: openssl rand -base64 32   (BACK THIS UP – without it stored sessions cannot be decrypted)
ENCRYPTION_KEY=
# Public origin(s) of the admin panel (CSRF origin check), comma-separated if several (e.g. with www).
# Must match what the browser shows, including https and no trailing slash.
APP_ORIGIN=https://support.example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
REQUIRE_MFA_FOR_PRIVILEGED=true
# Delete messages older than N days (0 = keep forever). Set per your privacy policy.
MESSAGE_RETENTION_DAYS=365

# --- Telegram user-account login (optional). From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Which optional services run: caddy = built-in HTTPS proxy, media = ClamAV. Set automatically by the wizard.
COMPOSE_PROFILES=caddy
# External-proxy mode (existing nginx): COMPOSE_FILE=docker-compose.yml:docker-compose.external.yml and no 'caddy' profile
# REPORT_TZ=Asia/Jerusalem

# Android app (android/ folder): the SHA-256 fingerprint of the app's signing certificate (colon-separated; several separated by commas).
# With it the app opens the panel full-screen without a browser bar. Not a secret.
# ANDROID_APP_PACKAGE=net.rubinny.botwa
# ANDROID_APP_SHA256=

# --- Safety / alerts
# POST a JSON alert (Slack/Discord/Mattermost-compatible "text" field) when a channel is logged out, restricted or in error.
ALERT_WEBHOOK_URL=
# Contact shown to Wikimedia in the User-Agent when importing safety laws (knowledge base > laws). Default: APP_ORIGIN.
# GOV_IMPORT_CONTACT=
# Auto-block a customer who sends more than this many messages within 2 minutes (0 = off)
FLOOD_LIMIT=30

# --- Attachments (images/PDF/Word/Excel/audio/video). OFF unless an antivirus daemon is configured.
# Docker: CLAMAV_HOST=clamav and start with `docker compose --profile media up -d`
CLAMAV_HOST=
CLAMAV_PORT=3310
# max 25 (clamd StreamMaxLength default); larger files cannot be scanned
MEDIA_MAX_MB=16
# stop accepting inbound files above this total stored size
MEDIA_MAX_TOTAL_GB=20
MEDIA_MAX_FILES_PER_CONTACT_DAY=50
# MEDIA_ALLOW_UNSCANNED=false   # development ONLY: accept files without antivirus. Never in production.
# FFMPEG_PATH=ffmpeg            # turns GIFs into short videos so WhatsApp plays them; empty = off (still picture)
# Optional local model (Ollama) that words the bot's answers from the knowledge base only. Set automatically by
# scripts/enable-local-llm.sh (see docs/LOCAL_LLM.he.md):
# LOCAL_LLM_URL=http://ollama:11434
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# LOCAL_LLM_TIMEOUT_MS=60000
# OLLAMA_VERSION=
# RATE_LIMIT_PER_MIN=300        # general requests per minute per signed-in browser (per address before sign-in)

# --- Encrypted database backups from the admin panel (needs pg_dump in the image; Dockerfile installs it)
BACKUP_KEEP=14
# Hour of day (0-23, server local time) for an automatic daily backup. Leave blank for manual only.
BACKUP_AUTO_HOUR=3

# --- Non-Docker only (compose overrides these) ---
# DATABASE_URL=postgres://botwa:PASSWORD@localhost:5432/botwa
# HOST=127.0.0.1
# MEDIA_DIR=./data/media
# BACKUP_DIR=./data/backups
# TRUST_PROXY=false

# Passkeys: RP ID is derived from APP_ORIGIN; uncomment only to override (must be a parent domain of APP_ORIGIN)
# WEBAUTHN_RP_ID=

# Debug only: Baileys protocol logs (may contain phone numbers). Leave unset in production.
# BAILEYS_LOG_LEVEL=debug

# Knowledge base: days to keep the log of customer questions (short customer text, used to find missing answers)
# KB_QUERY_RETENTION_DAYS=30

# "Meaning" search (local model, no external AI service; one-time model download ~120MB from huggingface.co).
# Enable: set WITH_SEMANTIC=1 and SEMANTIC_SEARCH=local, then rebuild:  docker compose build server && docker compose up -d
# WITH_SEMANTIC=1
# SEMANTIC_SEARCH=local
# SEMANTIC_MODEL=Xenova/multilingual-e5-small

# Headless browser for pages that build their content with JavaScript (separate locked-down container; ~0.4GB image, ~1GB RAM while working).
# Easiest: run scripts/enable-browser.sh. By hand: add "browser" to COMPOSE_PROFILES, set the three lines below, then docker compose up -d --build
# BROWSER_TOKEN=            # at least 24 random characters, shared by the server and the browser container
# BROWSER_URL=http://browser:3100
# (in-process alternative, less isolated: WITH_BROWSER=1 and BROWSER=local)

# Staying signed in: a sign-in is renewed while the panel is in use. Without "stay signed in" it ends after this many idle hours;
# with it, after this many idle days. Nobody stays signed in longer than SESSION_MAX_DAYS from the moment they typed the password.
# SESSION_TTL_HOURS=12
# SESSION_REMEMBER_DAYS=30
# SESSION_MAX_DAYS=90

# Emergency switch for the panel firewall (Settings > Security) if you locked yourself out; remove after fixing.
# FIREWALL_DISABLE=true
